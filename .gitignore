# Ignore everything that is fetched rather than authored.
/repos/
/node_modules/

# Editor / OS / runtime noise
.DS_Store
*.log
*.tmp
__pycache__/
*.pyc
.wrangler/
.dev.vars
.env
.env.*

# Proofs are regenerated by tools/reproduce.sh and are committed on purpose, so
# nothing here excludes proofs/ — but a failed fetch leaves no stray temp file.
proofs/*.tmp.*
